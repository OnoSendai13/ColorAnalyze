{
  "expo": {
    "name": "ColorAnalyze",
    "slug": "ColorAnalyze",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coloranalyze.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ColorAnalyze needs access to your photo library to analyze the colors of your images. No image is sent to any server."
      }
    },
    "android": {
      "package": "com.coloranalyze.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "extra": {
      "privacyPolicyUrl": "https://coloranalyze.app/privacy",
      "contactEmail": "contact@coloranalyze.app"
    }
  }
}
